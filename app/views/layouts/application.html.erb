<!DOCTYPE html>
<html>
  <head>
    <title>PrBot</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# prismjs %>
    <link href="https://unpkg.com/prismjs@1.29.0/themes/prism-tomorrow.css" rel="stylesheet" />
    <script src="https://unpkg.com/prismjs@1.29.0/components/prism-core.js"></script>
    <script src="https://unpkg.com/prismjs@1.29.0/plugins/autoloader/prism-autoloader.js"></script>
  </head>

  <body>
    <%# placeholder for modal targets %>
    <%= turbo_frame_tag "modal" %>
    <%= turbo_frame_tag "turbo_scripts" %>

    <main class="p-3">
      <%= link_to root_url do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
      <% end %>
      <div class="my-8 w-[70%] min-w-[100%] px-3 md:min-w-[768px] mx-auto">
        <%= turbo_frame_tag "flash" do %>
          <%= render "shared/flash" %>
        <% end %>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
