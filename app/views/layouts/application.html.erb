<!DOCTYPE html>
<html>
  <head>
    <title>PrBot</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# prismjs %>
    <link href="https://unpkg.com/prismjs@1.29.0/themes/prism-tomorrow.css" rel="stylesheet" />
    <script src="https://unpkg.com/prismjs@1.29.0/components/prism-core.js"></script>
    <script src="https://unpkg.com/prismjs@1.29.0/plugins/autoloader/prism-autoloader.js"></script>
  </head>

  <body>
    <%# placeholder for modal targets %>
    <%= turbo_frame_tag "modal" %>
    <%= turbo_frame_tag "turbo_scripts" %>

    <main class="p-3">
      <div class="flex items-center gap-2">
        <%= link_to root_url do %>
          <%= heroicon :home %>
        <% end %>

        <div data-controller="mute" data-action="click->mute#toggle" class="cursor-pointer">
          <%= heroicon "speaker-wave", options: { class: "#{'hidden' unless cookies['playSound'] == 'true'}", "data-mute-target": "unmutedIcon" } %>
          <%= heroicon "speaker-x-mark", options: { class: "#{'hidden' if cookies['playSound'] == 'true'}", "data-mute-target": "mutedIcon" } %>
        </div>
      </div>

      <div class="my-8 w-[100%] px-3 lg:max-w-[80%] mx-auto">
        <%= turbo_frame_tag "flash" do %>
          <%= render "shared/flash" %>
        <% end %>

        <%= yield %>
      </div>
    </main>
  </body>
</html>
