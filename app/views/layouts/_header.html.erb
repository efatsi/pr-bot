<div
  class="inline-flex items-start gap-2 p-2 px-3 bg-gray-800 text-gray-300 rounded-lg border border-white border-opacity-40"
  data-controller="header"
>
  <div class="inline-flex items-center gap-2">
    <%= link_to root_url do %>
      <%= heroicon :home %>
    <% end %>

    <div data-controller="mute" data-action="click->mute#toggle" class="cursor-pointer">
      <%= heroicon "speaker-wave", options: { class: "#{'hidden' unless cookies['playSound'] == 'true'}", "data-mute-target": "unmutedIcon" } %>
      <%= heroicon "speaker-x-mark", options: { class: "#{'hidden' if cookies['playSound'] == 'true'}", "data-mute-target": "mutedIcon" } %>
    </div>

    <div
      class="ml-2 flex items-center gap-1 cursor-pointer fill-[#c4c8cd] hover:fill-gray-200 hover:text-gray-200"
      data-action="click->header#toggleRobots"
    >
      <%= render "custom_svgs/robot_face" %>
      <span data-header-target="robotCount">1</span>
    </div>
  </div>

  <div class="hidden flex flex-col gap-1 mt-0.5 text-xs" data-header-target="robots">
    <div>
      <input
        data-action="change->header#handleRobotChange"
        data-header-target="robotInput"
        type="checkbox"
        id="gpt"
        name="gpt"
        value="gpt"
        checked
      >
      <label for="gpt">gpt</label>
    </div>
    <div>
      <input
        data-action="change->header#handleRobotChange"
        data-header-target="robotInput"
        type="checkbox"
        id="gemini"
        name="gemini"
        value="gemini"
      >
      <label for="gemini">gemini</label>
    </div>
  </div>
</div>
