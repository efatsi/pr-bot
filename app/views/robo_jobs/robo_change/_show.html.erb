<% label_class = dropdown_label_bg_for(robo_change) %>
<% label_action = render("robo_jobs/robo_change/actions/#{robo_change.status}", robo_change: robo_change) %>

<div id="robo-change-<%= robo_change.id %>">
  <%= render "shared/dropdown", label: robo_change.summary, label_class: label_class, label_action: label_action do %>
    <% if robo_change.error %>
      <div class="mb-4">
        <div class="font-medium">Error:</div>
        <pre class="text-red-700"><%= robo_change.error %></pre>
      </div>
    <% end %>

    <div class="flex gap-8">
      <div class="mb-4">
        <div class="font-medium">File:</div>
        <%= robo_change.file %>
      </div>

      <% if robo_change.action == "rename_file" %>
        <div class="mb-4">
          <div class="font-medium">New File:</div>
          <%= robo_change.new_file %>
        </div>
      <% end %>
    </div>
    <div class="flex mb-2 gap-1">
      <% if robo_change.action == "update_file" %>
        <div class="diff-og">
          <div class="font-medium mb-2">OG Content:</div>
          <pre><%= robo_change.original_content %></pre>
        </div>
      <% end %>
      <% if robo_change.action.in? ["add_file", "update_file"] %>
        <div class="diff-new">
          <div class="font-medium mb-2">New Content:</div>
          <pre><%= robo_change.new_content %></pre>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
