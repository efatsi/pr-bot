<%= turbo_frame_tag "robo-job-start-details" do %>
  <%= simple_form_for robo_job, url: update_feature_and_files_robo_job_path(robo_job) do |f| %>
    <div class="flex justify-end gap-2 my-2">
      <%= link_to "Cancel", :back, class: "btn-opaque leading-6 inline-block" %>
      <%= f.button :submit, "Update", class: "btn-primary" %>
    </div>

    <%= render "robo_jobs/feature_and_files_inputs", f: f, robo_job: robo_job %>
  <% end %>
<% end %>
