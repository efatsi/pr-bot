<div class="mb-8">
  <%= render "shared/dropdown", label: "RoboJob Details", open_on_load: false do %>
    <div class="float-right">
      <%= link_to "Edit", edit_robo_job_path(robo_job), class: "btn-opaque mr-4" %>
    </div>

    <div class="mb-8">
      <div class="font-semibold mb-1">Project:</div>
      <span><%= link_to project.filepath, project_path(project) %></span>
    </div>

    <div class="mb-8">
      <div class="font-semibold mb-1">Project Context:</div>
      <span><%= project.project_context %></span>
    </div>

    <div class="mb-1">
      <div class="font-semibold mb-1">Feature Request:</div>
      <div class="whitespace-pre-wrap"><%= robo_job.feature_request %></div>
    </div>
  <% end %>
</div>

<div id="get-files" class="mb-8">
  <%= render "robo_jobs/files/index" %>
</div>

<div id="get-instructions" class="mb-8">
  <%= render "robo_jobs/instructions/index" %>
</div>
<% if robo_job.robo_changes.executed.exists? %>
  <%= link_to 'Create Git Commit', new_project_git_commit_path(project, robo_job_id: robo_job.id, modal: true),
    class: "btn-primary",
    "data-turbo-frame": "modal"
  %>
<% end %>
