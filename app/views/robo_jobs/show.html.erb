<div class="w-[70%] min-w-[600px] mx-auto">
  <div class="mb-8">
    <div class="font-semibold mb-1">Repo Filepath:</div>
    <span><%= link_to @robo_job.filepath, "file:#{@robo_job.filepath}" %></span>
  </div>

  <div class="mb-8">
    <div class="font-semibold mb-1">Project Context:</div>
    <span><%= @robo_job.project_context %></span>
  </div>

  <div class="mb-8">
    <div class="font-semibold mb-1">Feature Request:</div>
    <span><%= @robo_job.feature_request %></span>
  </div>

  <div class="mb-8">
    <% if @robo_job.relevant_files.any? %>
      <div class="font-semibold mb-1">Relevant Files:</div>
      <ul class="list-disc text-left pl-5">
        <% @robo_job.relevant_files.each do |filepath| %>
          <li><%= filepath %></li>
        <% end %>
      </ul>
    <% else %>
      <div data-controller="ss-stream" data-ss-stream-url-value="<%= get_files_robo_job_path(@robo_job) %>" id="get-files">
        <%= link_to "Let's go!", "#", class: "btn-primary", "data-action": "ss-stream#startConnection" %>
      </div>
    <% end %>
  </div>
</div>
