
<div class="mb-8">
  <div class="font-semibold mb-1">Repo Filepath:</div>
  <span><%= link_to robo_job.filepath, "file:#{robo_job.filepath}" %></span>
</div>

<div class="mb-8">
  <div class="font-semibold mb-1">Project Context:</div>
  <span><%= robo_job.project_context %></span>
</div>

<div class="mb-8">
  <div class="font-semibold mb-1">Feature Request:</div>
  <span><%= robo_job.feature_request %></span>
</div>

<div id="get-files">
  <%= render "robo_jobs/files/index" %>
</div>

<div id="get-instructions">
  <%= render "robo_jobs/instructions/index" %>
</div>
