<div class="mb-8">
  <%= render "shared/dropdown", label: "Project Details", open_on_load: false do %>
    <div class="float-right">
      <%= link_to "+ New Job", new_robo_job_path(project_id: project.id), class: "btn-primary mr-1" %>
    </div>

    <div class="mb-8">
      <div class="font-semibold mb-1">Project:</div>
      <span><%= link_to project.filepath, project_path(project) %></span>
    </div>

    <div class="mb-4">
      <div class="font-semibold mb-1">Project Context:</div>
      <span><%= project.project_context %></span>
    </div>
  <% end %>
</div>

<div class="flow-root">
  <div role="list">
    <%# render the start event, it will be responsible for rendering following events or available actions %>
    <%= render "robo_events/list_item", robo_event: robo_job.start_event %>
  </div>
</div>


<div data-controller="websocket" data-websocket-robo-job-id-value="<%= robo_job.id %>"></div>
