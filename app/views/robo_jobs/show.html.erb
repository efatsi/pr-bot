
<div class="mb-8">
  <div class="font-semibold mb-1">Repo Filepath:</div>
  <span><%= link_to robo_job.filepath, "file:#{robo_job.filepath}" %></span>
</div>

<div class="mb-8">
  <div class="font-semibold mb-1">Project Context:</div>
  <span><%= robo_job.project_context %></span>
</div>

<div class="mb-8">
  <div class="font-semibold mb-1">Feature Request:</div>
  <span><%= robo_job.feature_request %></span>
</div>

<div class="mb-8">
  <% contextual_files_request = robo_job.robo_requests.of_type("contextual_files") %>

  <% if contextual_files_request %>
    <%= render "robo_jobs/files/finished", robo_request: contextual_files_request %>

  <% else %>
    <% stream_path = get_contextual_files_robo_job_path(robo_job) %>

    <div data-controller="ss-stream" data-ss-stream-url-value="<%= stream_path %>" id="get-files">
      <%= link_to "Step 1: Gather Contextual Files", stream_path, class: "btn-primary", "data-action": "ss-stream#startConnection" %>
    </div>
  <% end %>
</div>

<div id="get-instructions">
  <%= render "robo_jobs/instructions/preflight", robo_request: contextual_files_request %>
</div>
