<% instruction_requests = robo_job.robo_requests.of_type("instructions") %>
<% many_requests = instruction_requests.count > 1 %>

<% if many_requests %>
  <%= render "shared/dropdown", label: "Conversation" do %>
    <% instruction_requests.each_with_index do |robo_request, i| %>
      <div class="mb-4">
        <%= render "shared/dropdown", label: "Prompt ##{ i+1 }" do %>
          <div class="whitespace-pre"><%== robo_request.prompt.gsub("\n", "<br>") %></div>
        <% end %>

        <%= render "shared/dropdown", label: "Response" do %>
          <pre><%= robo_request.response %></pre>
        <% end %>
      </div>
    <% end %>
  <% end %>

<% else %>
  <% robo_request = instruction_requests.first %>

  <div class="mb-4">
    <%= render "shared/dropdown", label: "Prompt" do %>
      <div class="whitespace-pre"><%== robo_request.prompt.gsub("\n", "<br>") %></div>
    <% end %>

    <%= render "shared/dropdown", label: "Response" do %>
      <pre><%= robo_request.response %></pre>
    <% end %>
  </div>
<% end %>
