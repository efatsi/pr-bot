<% if !robo_job.generated_instructions? && !robo_job.generated_plan? %>
  <div class="flex justify-around mt-8 mb-4">
    <div>
      <p>Quick & Easy?</p>
      <%= button_to "Step 2: Build Instructions", get_instructions_robo_job_path(robo_job), method: :post, class: "btn-primary" %>
    </div>
    <div>
      <p>Requires some thinking?</p>
      <%= button_to "Step 2: Build Plan", build_plan_robo_job_path(robo_job), method: :post, class: "btn-primary" %>
    </div>
  </div>
<% else %>
  <%= render "robo_jobs/instructions/finished" %>
<% end %>
