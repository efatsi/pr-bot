<%# Don't render this if haven't gotten to that step yet  %>
<% if robo_job.contextual_files.any? || robo_job.robo_requests.of_type("contextual_files").any? %>
  <% if !robo_job.generated_instructions? %>
    <%= button_to "Step 2: Build Instructions", get_instructions_robo_job_path(robo_job), method: :post, class: "btn-primary" %>

  <% else %>
    <%= render "robo_jobs/instructions/finished" %>
  <% end %>

  <% if robo_job.actions.none? %>
    <%# todo: turn this into a regular post request instead of stream_button %>
    <%= render "shared/stream_button", path: build_plan_robo_job_path(robo_job), label: "Step 2: Build Plan" %>
  <% end %>
<% end %>
