<% ding ||= false %>
<%= render "shared/ding" if ding %>

<%= render "shared/dropdown", label: "Build Instructions", open_on_load: true do %>
  <div class="px-1">
    <%= turbo_frame_tag "actions" do %>
      <%= render "robo_jobs/instructions/actions", robo_job: robo_job %>
    <% end %>
  </div>
<% end %>

<div class="flex justify-between mt-8 mb-4">
  <div>
    <%= link_to "Continue the Conversation ->",
      new_robo_job_followup_job_path(robo_job),
      class: "btn-opaque"
    %>
  </div>

  <%= turbo_frame_tag "commit-button" do %>
    <%= render "actions/commit_button", robo_job: robo_job %>
  <% end %>
</div>
