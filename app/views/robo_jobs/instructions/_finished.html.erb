<% open_on_load ||= false %>

<%= render "shared/dropdown", label: "Build Instructions", open_on_load: open_on_load do %>
  <%= render "shared/dropdown", label: "Prompt" do %>
    <%== robo_request.prompt.gsub("\n", "<br>") %>
  <% end %>

  <%= render "shared/dropdown", label: "Response" do %>
    <%== markdown_to_html(robo_request.response) %>
  <% end %>

  <div class="px-1">
    <div class="font-semibold mt-4 mb-2">Code Instructions:</div>
    <%== markdown_to_html(robo_job.generated_instructions) %>
  </div>
<% end %>
