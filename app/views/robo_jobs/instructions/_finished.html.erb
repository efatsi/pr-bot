<%= render "shared/dropdown", label: "Build Instructions", open_on_load: true do %>
  <div class="px-1">
    <div class="mb-6" id="robo-changes">
      <%= render "robo_jobs/instructions/robo_changes", robo_job: robo_job %>
    </div>

    <%= turbo_frame_tag "continue-conversation" %>

    <div class="flex flex-col gap-4 mt-8 mb-4">
      <div>
        <%= link_to "Continue the Conversation ->",
          new_robo_job_followup_job_path(robo_job),
          class: "btn-opaque",
          "data-turbo-frame": "continue-conversation"
        %>
      </div>

      <% if robo_job.robo_changes.executed.exists? %>
        <div>
          <%= link_to 'Create Git Commit', new_project_git_commit_path(project, robo_job_id: robo_job.id, modal: true),
            class: "btn-primary",
            "data-turbo-frame": "modal"
          %>
        </div>
      <% end %>
    </div>

  </div>
<% end %>
