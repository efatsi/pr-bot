<%= render "shared/dropdown", label: "Build Instructions", open_on_load: true do %>
  <div class="px-1">
    <div class="mb-6" id="robo-changes">
      <div class="flex justify-between items-start mb-4">
        <div class="inline-block font-medium border-b border-opacity-10 mb-1.5">Proposed Changes</div>

        <% if !robo_job.all_robo_changes.pending.any? %>
          <div id="fire-all">
            <%= render "shared/stream_button",
              path: execute_all_robo_job_robo_changes_path(robo_job),
              label: "Fire All!",
              class_name: "btn-opaque mr-4"
            %>
          </div>
        <% end %>
      </div>

      <%= render "robo_jobs/instructions/robo_changes" %>
    </div>

    <div class="flex justify-between mt-8 mb-4">
      <div>
        <%= link_to "Continue ->", new_robo_job_followup_job_path(robo_job), class: "btn-opaque" %>
      </div>

      <% if robo_job.robo_changes.executed.exists? %>
        <div>
          <%= link_to 'Create Git Commit', new_project_git_commit_path(project, robo_job_id: robo_job.id, modal: true),
            class: "btn-primary",
            "data-turbo-frame": "modal"
          %>
        </div>
      <% end %>
    </div>

  </div>
<% end %>
