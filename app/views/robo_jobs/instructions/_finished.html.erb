<% open_on_load ||= true %>

<%= render "shared/dropdown", label: "Build Instructions", open_on_load: open_on_load do %>
  <%= render "shared/dropdown", label: "Prompt" do %>
    <%== robo_request.prompt.gsub("\n", "<br>") %>
  <% end %>

  <%= render "shared/dropdown", label: "Response" do %>
    <%= robo_request.response %>
  <% end %>

  <div class="px-1">
    <div class="inline-block font-medium mt-4 mb-2 border-b border-opacity-10">Code Instructions:</div>

    <div class="mb-4">
      <div class="font-medium mb-1">Implementation Overview</div>
      <p><%= robo_job.parsed_instructions["implementation_overview"] %></p>
    </div>

    <div class="mb-4">
      <div class="font-medium mb-2">Proposed Changes</div>
        <% robo_job.robo_changes.each do |changeset| %>
          <% label_class = changeset.action == "update_file" ? "bg-[#523823]" : "bg-[#263a23]" %>

          <%= render "shared/dropdown", label: changeset.summary, label_class: label_class do %>
            <div class="mb-1.5">
              <b>File:</b><br>
              <%= changeset.file %>
            </div>
            <% if changeset.action == "update_file" %>
              <div class="mb-1.5">
                <b>OG Content:</b>
                <pre><%= changeset.original_content %></pre>
              </div>
            <% end %>

            <div class="mb-1.5">
              <b>New Content:</b>
              <pre><%= changeset.new_content %></pre>
            </div>

          <% end %>
        <% end %>
      </div>
    </div>

    <% if robo_job.parsed_instructions["additional_notes"] %>
      <div class="mb-4">
        <div class="font-medium mb-1">Additional Notes</div>
        <p><%= robo_job.parsed_instructions["additional_notes"] %></p>
      </div>
    <% end %>
  </div>
<% end %>
