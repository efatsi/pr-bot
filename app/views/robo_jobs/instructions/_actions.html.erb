<% ding ||= false %>
<%= render "shared/ding" if ding %>

<div class="mb-6">
  <div class="inline-block font-medium border-b border-opacity-10 mb-4">Action Plan</div>

  <% [robo_job, *robo_job.followup_jobs].each do |job| %>
    <% if job.actions.any? %>
      <div class="mb-4">
        <%= render "actions/index", robo_job: job %>
      </div>
    <% end %>
  <% end %>
</div>

<%# placeholder tag to drop the continue form into %>
<%= turbo_frame_tag "continue-conversation" %>
