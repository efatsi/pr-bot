<div class="flex justify-between mb-2">
  <div class="inline-block font-medium border-b border-opacity-10 mb-1.5">Proposed Changes</div>

  <% if robo_job.all_robo_changes.pending.any? %>
    <% stream_path = execute_all_robo_job_robo_changes_path(robo_job) %>
    <div data-controller="ss-stream" data-ss-stream-url-value="<%= stream_path %>" id="fire-all">
      <%= link_to "Fire All!", stream_path, class: "btn-opaque mr-4", "data-action": "ss-stream#startConnection" %>
    </div>
  <% end %>
</div>

<% robo_job.all_robo_changes.each do |robo_change| %>
  <%= render "robo_jobs/robo_change/show", robo_change: robo_change %>
<% end %>
