<% ding ||= false %>
<%= render "shared/ding" if ding %>

<div class="mb-6" id="robo-changes">
  <div class="inline-block font-medium border-b border-opacity-10 mb-4">Proposed Changes</div>

  <% [robo_job, *robo_job.followup_jobs].each do |job| %>
    <% if job.robo_changes.any? %>
      <div class="mb-4">
        <%= render "robo_jobs/robo_changes/index", robo_job: job %>
      </div>
    <% end %>
  <% end %>
</div>

<%# placeholder tag to drop the continue form into %>
<%= turbo_frame_tag "continue-conversation" %>
