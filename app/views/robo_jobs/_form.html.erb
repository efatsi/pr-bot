<div class="font-semibold mb-4"><%= label %></div>

<%= simple_form_for robo_job do |f| %>
  <div class="form-inputs">
    <div class="flex items-center gap-4">
      <%= f.association :project, collection: Project.by_id, selected: params[:project_id] || robo_job.project_id, prompt: nil, input_html: { class: "!w-96" } %>
    </div>

    <div class="flex gap-2">
      <div class="w-1/2">
        <%= f.input :feature_request, input_html: { rows: 10 }, hint: "optional: use markdown & ``` code blocks for nicer rendering" %>
      </div>
      <div class="w-1/2">
        <%= f.input :contextual_files, as: :text,
          hint: "load files in that you know are relevant, we can build on this later",
          input_html: {
            rows: [robo_job.contextual_files.length + 1, 10].max,
            value: robo_job.contextual_files.join("\n")
          }
        %>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.button :submit, button_text, class: "btn-primary" %>
    <%= link_to "Cancel", :back, class: "btn-opaque leading-6 inline-block" %>
  </div>
<% end %>
