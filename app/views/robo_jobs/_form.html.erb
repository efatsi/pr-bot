<div class="font-semibold mb-4"><%= label %></div>

<%= simple_form_for robo_job do |f| %>
  <div class="form-inputs">
    <div class="flex items-center gap-4">
      <%= f.association :project, collection: Project.all, prompt: nil, input_html: { class: "!w-96" } %>
      <%= link_to "+ Project", new_project_path, class: "btn-opaque" %>
    </div>
    <%= f.input :feature_request, input_html: { rows: 15 }, hint: "optional: use markdown & ``` code blocks for nicer rendering" %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, button_text %>
  </div>
<% end %>
