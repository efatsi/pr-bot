<div data-controller="toggle">
  <div data-toggle-target="content1">
    <div class="flex justify-between items-end">
      <div class="inline-block font-medium mt-4 mb-2 border-b border-opacity-10">Files:</div>
      <%= link_to "Edit", "#", class: "btn-opaque", "data-action": "toggle#toggleContent" %>
    </div>

    <ul class="list-disc text-left pl-5" data-inline-edit-target="content">
      <% robo_job.contextual_files.each do |filepath| %>
        <li class="flex items-center gap-1.5">
          <%= filepath %>
          <% if robo_job.project.invalid_path?(filepath) %>
            <%= heroicon "exclamation-circle", variant: :outline, options: { class: "text-red-500 w-4 h-4" } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <div data-toggle-target="content2" class="hidden">
    <%= render "robo_jobs/files/form", robo_job: robo_job %>
  </div>
</div>
