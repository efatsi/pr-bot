<div class="mb-8">
  <% contextual_files_request = robo_job.robo_requests.of_type("contextual_files").last %>

  <% if contextual_files_request %>
    <%= render "robo_jobs/files/finished", robo_request: contextual_files_request %>

  <% else %>
    <%= render "shared/stream_button", path: get_contextual_files_robo_job_path(robo_job), label: "Step 1: Gather Contextual Files" %>
  <% end %>
</div>
