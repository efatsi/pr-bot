<% open_on_load ||= false %>

<%= render "shared/dropdown", label: "Contextual Files", open_on_load: open_on_load do %>
  <%= render "shared/dropdown", label: "Prompt" do %>
    <%== robo_request.prompt.gsub("\n", "<br>") %>
  <% end %>

  <%= render "shared/dropdown", label: "Response" do %>
    <%== markdown_to_html(robo_request.response) %>
  <% end %>

  <div class="px-1">
    <div class="font-semibold mt-4 mb-2">Files:</div>
    <ul class="list-disc text-left pl-5">
      <% robo_job.contextual_files.each do |filepath| %>
        <li><%= filepath %></li>
      <% end %>
    </ul>
  </div>
<% end %>
