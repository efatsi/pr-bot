<% open_on_load ||= session[:show_files] %>
<% ding ||= false %>
<%= render "shared/ding" if ding %>

<%= render "shared/dropdown", label: "Contextual Files", open_on_load: open_on_load do %>
  <% if robo_request %>
    <%= render "shared/dropdown", label: "Prompt" do %>
      <%= render "shared/prompt_conversation", robo_request: robo_request %>
    <% end %>

    <% if robo_request.response.present? %>
      <%= render "shared/dropdown", label: "Response" do %>
        <pre class="whitespace-pre-wrap"><%= robo_request.response %></pre>
      <% end %>
    <% else %>
      <p class="italic ml-1 mb-2 text-sm">no response, defined manually</p>
    <% end %>
  <% else %>
    <p class="italic ml-1 mb-2 text-sm">no robo_request, defined manually</p>
  <% end %>

  <div class="px-1">
    <div id="files-and-form">
      <%= render "robo_jobs/files/files_and_form", robo_job: robo_job %>
    </div>
  </div>
<% end %>
