<% open_on_load ||= session[:show_files] %>
<% ding ||= false %>
<%= render "shared/ding" if ding %>

<%= render "shared/dropdown", label: "Contextual Files", open_on_load: open_on_load do %>
  <% if robo_request %>
    <div class="flex justify-center gap-1">
      <%= link_to conversation_robo_job_path(robo_job, type: ["contextual_files"].join(",")), "data-turbo-frame": "modal" do %>
        <div class="inline-flex items-center gap-1 btn-opaque btn-slim text-sm">
          <span>convo</span>
          <%= heroicon "arrow-top-right-on-square", options: { class: "!w-4 !h-4" } %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="italic ml-1 mb-2 text-sm">no robo_request, defined manually</p>
  <% end %>

  <div class="px-1">
    <div id="files-and-form">
      <%= render "robo_jobs/files/files_and_form", robo_job: robo_job %>
    </div>
  </div>
<% end %>
