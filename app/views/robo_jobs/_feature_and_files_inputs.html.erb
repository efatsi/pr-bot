<div class="flex gap-4">
  <div class="w-3/5">
    <%= f.input :feature_request,
      input_html: { rows: 10 },
      hint: "optional: use markdown & ``` code blocks for nicer rendering"
    %>
  </div>

  <div class="w-2/5">
    <%= f.input :contextual_files,
      as: :text,
      input_html: {
        rows: [robo_job.contextual_files.length + 1, 10].max,
        value: robo_job.contextual_files.join("\n")
      },
      hint: "load files in that you know are relevant, we can build on this later"
    %>
  </div>
</div>
