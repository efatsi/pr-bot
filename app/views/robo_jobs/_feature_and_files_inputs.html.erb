<% feature_label ||= "Feature Request" %>
<% feature_hint ||= "basic markdown & ``` code blocks supported<br>use &lt;docs&gt; ... &lt;/docs&gt; tags for collapsed rendering".html_safe %>
<% files_hint ||= "load files in that you know are relevant, we can build on this later" %>

<div class="flex gap-4">
  <div class="w-3/5">
    <%= f.label :feature_request, feature_label, required: false, class: "input-label" %>
    <%= f.input :feature_request,
      label: false,
      input_html: {
        rows: 8,
        "data-controller": "autofocus"
      },
      hint: feature_hint
    %>
  </div>

  <div class="w-2/5">
    <% files_input_id = "contextual-file-input-#{robo_job.id || -1}" %>

    <%= f.label files_input_id, "Contextual files", class: "input-label" %>
    <div class="flex flex-col">
      <%= f.input :seed_contextual_files, as: :text, label: false,
        hint: files_hint,
        wrapper_html: { class: "!mb-2" },
        input_html: {
          id: files_input_id,
          rows: [robo_job.seed_contextual_files.length + 1, 8].max,
          value: robo_job.seed_contextual_files.join("\n")
        }
      %>

      <% if robo_job.project %>
        <%= link_to fuzzy_finder_project_path(robo_job.project, input_id: files_input_id), class: "btn-opaque whitespace-nowrap self-end flex items-center gap-2", "data-turbo-frame": "modal" do %>
          <%= heroicon "magnifying-glass-plus", options: { class: "inline" } %>
          <span>File Finder</span>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="mb-4">
  <div class="w-1/2">
    <label class="input-label">Upload Images (optional)</label>
    <%= f.input :images, as: :file, input_html: { multiple: true }, label: false %>

    <% if robo_job.images.any? %>
      <div class="my-4">
        <p class="input-label">Existing Images:</p>
        <div class="flex flex-wrap gap-2">
          <% robo_job.images.each do |image| %>
            <div class="hover:opacity-70 relative group" data-controller="image-edit">
              <button class="hidden group-hover:inline-block absolute right-1 top-2 p-1 bg-white bg-opacity-70 hover:bg-opacity-100 rounded-md" data-action="click->image-edit#destroy">
                <%= heroicon "trash", options: { class: "text-red-500" } %>
              </button>
              <%= image_tag(image.variant(:thumb)) %>
              <%= f.hidden_field :images, multiple: true, value: image.signed_id %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
