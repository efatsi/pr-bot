<div class="border p-3 my-6 rounded-md">
  <div class="mb-4">
    <div class="inline-block font-medium mb-2">Commits:</div>
    <br>

    <div>
      <% project.git_commits.newest_first.each do |gc| %>
        <div class="ml-2 mb-1">
          • <span class="ml-2"><%= gc.message %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>
