<div class="border p-3 my-6 rounded-md">
  <div class="mb-4">
    <div class="float-right mt-2 gap-2">
      <%= link_to '+ Commit', new_project_git_commit_path(project), class: 'btn-primary' %>
    </div>

    <div class="inline-block font-medium mb-1">Commits:</div>
    <br>

    <% project.git_commits.each do |gc| %>
      <%= gc.message %>
    <% end %>
  </div>
</div>
