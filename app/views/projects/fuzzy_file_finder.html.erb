<%= render "shared/modal" do %>
  <div
    class="min-h-[500px] px-4"
    data-controller="fuzzy-file-finder"
    data-fuzzy-file-finder-file-data-value="<%= project.fetch_directory_tree.to_json %>"
    data-fuzzy-file-finder-input-id-value="<%= params[:input_id] %>"
    data-fuzzy-file-finder-file-preview-url-value="<%= file_preview_project_path(project) %>"
  >
    <div class="flex flex-col gap-2">
      <div class="text-lg font-bold mb-3 text-center">File Search</div>

      <%= simple_form_for :fuzzy_search do |f| %>
        <%= f.input :text,
          as: :string,
          label: false,
          input_html: {
            class: "max-w-[75%]",
            autofocus: true,
            autocomplete: "off",
            "data-action": "input->fuzzy-file-finder#inputValueChanged",
            "data-fuzzy-file-finder-target": "input"
          }
        %>
      <% end %>

      <div data-fuzzy-file-finder-target="results">
        <span class="italic text-sm">results...</span>
      </div>
    </div>
  </div>
<% end %>
