<%= render "shared/modal" do %>
  <div class="min-h-[500px] px-4">
    <div
      class="flex max-w-[800px] transition-transform"
      data-controller="fuzzy-finder"
      data-fuzzy-finder-input-id-value="<%= params[:input_id] %>"
      data-fuzzy-finder-file-preview-url-value="<%= file_preview_project_path(project) %>"
      data-fuzzy-finder-file-name-search-url-value="<%= file_name_search_project_path(project) %>"
      data-fuzzy-finder-file-content-search-url-value="<%= file_content_search_project_path(project) %>"
    >
      <%# Make this the main fuzzy-finder target %>
      <div class="min-w-full" data-fuzzy-finder-target="fileSearch">
        <div class="text-lg font-bold mb-3 text-center">File Search</div>

        <%= simple_form_for :fuzzy_search, url: "#",
          method: :get,
          remote: true,
          html: {
            "data-type": "json",
            "data-action": "change->fuzzy-finder#handleFormChange"
          } do |f|
        %>
          <div class="flex items-center mb-4">
            <%= f.radio_button :mode, "file_name", checked: true, class: "mr-2" %>
            <%= f.label :mode_file_name, "File Name", class: "mr-4" %>

            <%= f.radio_button :mode, "file_content", class: "mr-2" %>
            <%= f.label :mode_file_content, "File Content" %>

            <%= f.check_box :regex, class: "ml-4 hidden", "data-fuzzy-finder-target": "contentSearch" %>
            <%= f.label :regex, "Regex Search", class: "ml-1 hidden", "data-fuzzy-finder-target": "contentSearch" %>

            <%= f.check_box :case_sensitive, class: "ml-4 hidden", "data-fuzzy-finder-target": "contentSearch" %>
            <%= f.label :case_sensitive, "Case Sensitive", class: "ml-1 hidden", "data-fuzzy-finder-target": "contentSearch" %>
          </div>

          <%= f.input :text,
            as: :string,
            label: false,
            input_html: {
              class: "max-w-[500px]",
              autofocus: true,
              autocomplete: "off",
              "data-action": "keyup->fuzzy-finder#slowHandleFormChange",
              "data-fuzzy-finder-target": "input"
            }
          %>
        <% end %>

        <div data-fuzzy-finder-target="results" class="min-w-[500px] max-w-full inline-block">
          <span class="italic text-sm">results...</span>
        </div>
      </div>

      <%# Add one that can slide in from right to show file contents %>
      <div class="min-w-full shrink-0 transition-transform max-h-0 overflow-y-scroll" data-fuzzy-finder-target="previewSection">
        <div class="mb-4">
          <%= link_to "<- Back", "#", "data-action": "fuzzy-finder#backToSearch", class: "btn-opaque" %>
          <%= link_to "+ Add", "#", "data-action": "fuzzy-finder#toggleFileSelection", class: "btn-opaque ml-2", "data-fuzzy-finder-target": "previewToggle" %>
        </div>

        <%# this div for placing filename %>
        <div data-fuzzy-finder-target="previewFile" class="mb-4 font-semibold text-center max-w-[800px]"></div>

        <%# this div for placing file contents %>
        <pre data-fuzzy-finder-target="previewContent"></pre>
      </div>
    </div>
  </div>
<% end %>
