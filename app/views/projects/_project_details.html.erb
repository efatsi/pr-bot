<div class="border p-3 my-6 rounded-md">
  <div class="mb-4">
    <div class="float-right mt-2 gap-2">
      <%= link_to "Edit", edit_project_path(project), class: "btn-opaque mr-2" %>
      <%= link_to '+ RoboJob', new_robo_job_path(project_id: project.id), class: 'btn-primary' %>
    </div>
    <div class="inline-block font-medium mb-1">Filepath:</div>
    <br>
    <%= project.filepath %>
  </div>

  <div class="mb-4">
    <div class="inline-block font-medium mb-1">Project Tools:</div>
    <br>
    <%= project.project_context %>
  </div>

  <div class="mb-4">
    <div class="inline-block font-medium mb-1">Project Cost:</div>
    <br>
    <%= number_to_currency(project.robo_requests.sum(:cost)) %>
  </div>

<% if project.parent_jobs.any? %>
    <%= render "shared/dropdown", label: "RoboJobs (#{project.parent_jobs.count})" do %>
      <ul>
        <% project.parent_jobs.newest_first.each do |robo_job| %>
          <li class="mb-2 flex justify-between">
            <div>
              <%= link_to robo_job_path(robo_job), class: "blue-link" do %>
                <%= "-> ##{robo_job.id}:" %>
              <% end %>
              <%= robo_job.feature_request.truncate(70) %>
            </div>
            <span><%= number_to_currency(robo_job.total_cost) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
