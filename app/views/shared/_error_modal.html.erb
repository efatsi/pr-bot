<%= render "shared/modal" do %>
  <%= render "shared/dropdown", label: "Error in event `<code>#{robo_event.event_type}</code>`".html_safe, open_on_load: true do %>
    <% if robo_requests %>
      <% robo_requests.each do |robo_request| %>
        <%= render "shared/dropdown", label: "Prompt" do %>
          <%= render "shared/prompt_conversation", robo_request: robo_request %>
        <% end %>
      <% end %>
    <% end %>

    <pre class="whitespace-pre-wrap text-red-600 mb-2">Error: <%= error.message %></pre>

    <%= render "shared/dropdown", label: "Backtrace", open_on_load: true do %>
      <div class="whitespace-pre"><%= error.backtrace.join("\n") %></div>
    <% end %>
  <% end %>
<% end %>
