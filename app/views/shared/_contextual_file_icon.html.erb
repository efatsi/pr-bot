<% spinner ||= false %>

<% if spinner %>
  <div class="inline-flex items-center justify-center text-center rounded-md p-1 px-2 border border-white text-gray-400 border-opacity-30 w-7 h-8">
    <div
      class="inline-block h-3.5 w-3.5 animate-spin rounded-full border-[3px] border-solid border-current border-r-transparent align-[-0.125em] motion-reduce:animate-[spin_1.5s_linear_infinite]"
      role="status"
    >
      <span class="!absolute !-m-px !h-px !w-px !overflow-hidden !whitespace-nowrap !border-0 !p-0 ![clip:rect(0,0,0,0)]">
        Loading...
      </span>
    </div>
  </div>
<% elsif contextual_file.relevance %>
  <span class="inline-flex items-center justify-center text-center rounded-md p-1 px-2 border border-white border-opacity-30 text-gray-400 whitespace-nowrap w-7 h-8">
    <%= contextual_file.relevance %>
  </span>
<% elsif contextual_file.accepted? %>
  <div class="inline-flex items-center justify-center text-center rounded-md p-1 px-2 border border-white text-gray-400 border-opacity-30 w-7 h-8">✓</div>
<% end %>
