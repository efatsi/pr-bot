<% open_on_load ||= false %>
<% label_class ||= "bg-[#3e3f40]" %>
<% label_action ||= nil %>

<div data-controller="dropdown" class="mb-2 border border-gray-600 rounded-md">
  <div class="flex justify-between p-2 pr-4 cursor-pointer rounded-md <%= label_class %> group/dropdown" data-action="click->dropdown#toggle">
    <span><%= label %></span>

    <div class="flex items-center gap-2">
      <% if label_action %>
        <div class="min-w-[24px]"><%= label_action %></div>
      <% end %>
      <span>v</span>
    </div>
  </div>

  <div data-dropdown-target="panel" class="<%= 'hidden' unless open_on_load %> p-2.5 mt-2">
    <%= yield %>
  </div>
</div>
