<% show_switcher = !showing_many_siblings && robo_request.sibling_requests.any? %>

<div class="flex flex-col items-center gap-2">
  <% if show_switcher %>
    <% self_index = robo_request.all_siblings.index(robo_request) + 1 %>
    <% sibling_count = robo_request.all_siblings.count %>

    <div class="flex gap-1">
      <% if robo_request.younger_siblings.any? %>
        <%= link_to robo_request_path(robo_request.younger_siblings.last), "data-turbo-frame": "robo-event-details-#{robo_request.robo_event.id}" do %>
          <%= heroicon "chevron-left", options: { class: "!w-4 !h-4 text-gray-200" } %>
        <% end %>
      <% else %>
        <%# mimic space of chevron link %>
        <div class="w-4"></div>
      <% end %>

      <code class="text-xs text-gray-400"><%= self_index %>/<%= sibling_count %></code>

      <% if robo_request.older_siblings.any? %>
        <%= link_to robo_request_path(robo_request.older_siblings.first), "data-turbo-frame": "robo-event-details-#{robo_request.robo_event.id}" do %>
          <%= heroicon "chevron-right", options: { class: "!w-4 !h-4 text-gray-200" } %>
        <% end %>
      <% else %>
        <%# mimic space of chevron link %>
        <div class="w-4"></div>
      <% end %>
    </div>
  <% end %>

  <span class="inline-block rounded-md p-1 px-2 border border-white border-opacity-30 text-gray-400">
    <%= robo_request.robot %>
  </span>
</div>
