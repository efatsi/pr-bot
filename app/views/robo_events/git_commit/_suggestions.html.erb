<div class="mb-4">

  <%= render "shared/dropdown", label: "Commit Suggestions", open_on_load: true do %>
    <div class="flex gap-2">
      <% robo_event.robo_requests.each do |robo_request| %>
        <div class="w-full">
          <div class="flex flex-col items-start">
            <span class="inline-block rounded-md p-2 px-4 mb-2 border border-white border-opacity-50">
              <%= robo_request.robot %>
            </span>

            <%= link_to conversation_robo_request_path(robo_request), "data-turbo-frame": "modal" do %>
              <div class="w-full inline-flex items-center justify-around gap-1 btn-opaque btn-slim text-sm">
                <span>convo</span>
                <%= heroicon "arrow-top-right-on-square", options: { class: "!w-4 !h-4" } %>
              </div>
            <% end %>
          </div>

          <div class="w-full flex flex-col gap-1">
            <div class="px-1 mt-4">
              <div class="font-semibold mb-4">
                Suggestions:
              </div>

              <div class="flex flex-col gap-4 font-mono">
                <% JSON.parse(robo_request.response).fetch("commits", []).each do |option| %>
                  <div class="flex items-center mb-2 gap-2">
                    <button data-action="commit-copy#useMessage" data-message="<%= option['message'] %>" data-description="<%= option['description'] %>" class="btn-opaque mr-2">
                      <%= heroicon "arrow-up-on-square-stack", options: { class: "!w-4 !h-4" } %>
                    </button>
                    <div>
                      <div><%= option['message'] %></div>
                      <% if option['description'].present? %>
                        <div class="ml-3 mt-0.5 text-sm whitespace-pre-wrap"><%= option['description'] %></div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

</div>
