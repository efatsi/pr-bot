<% open_on_load ||= false %>
<% ding ||= false %>
<%= render "shared/ding" if ding %>

<div class="mb-8">
  <%= render "shared/dropdown", label: "Enhance Feature Request", open_on_load: open_on_load do %>
    <div class="mb-1" data-controller="tabs">
      <div class="flex justify-center gap-1">
        <%= link_to "#", "data-action": "tabs#showTab", "data-tab-key": "input" do %>
          <div class="inline-flex items-center gap-1 btn-opaque btn-slim text-sm">
            <%= heroicon "microphone", options: { class: "!w-4 !h-4" } %>
            <span>input</span>
          </div>
        <% end %>

        <%= link_to conversation_robo_job_path(robo_job, type: "enhance_feature_request"), "data-turbo-frame": "modal" do %>
          <div class="inline-flex items-center gap-1 btn-opaque btn-slim text-sm">
            <span>convo</span>
            <%= heroicon "arrow-top-right-on-square", options: { class: "!w-4 !h-4" } %>
          </div>
        <% end %>
      </div>

      <div class="border border-white border-opacity-20 rounded p-2 hidden" data-tabs-target="tab" data-tab="input">
        <div class="whitespace-pre-wrap"><%= robo_job[:feature_request] %></div>
      </div>
    </div>

    <%= render "shared/dropdown", label: "Updated Prompt", open_on_load: true do %>
      <% enhance_request = robo_job.robo_requests.of_type("enhance_feature_request").last %>

      <div>
        <%= turbo_frame_tag "enhance-#{enhance_request.id}" do %>
          <%= render "shared/render_md_and_code", body: enhance_request.response %>
        <% end %>
      </div>
    <% end %>

    <div class="flex justify-end mt-4 mb-2">
      <%= button_to "Looks good? Bulid Instructions ->",
        build_instructions_robo_job_path(robo_job),
        method: :post,
        class: "btn-primary"
      %>
    </div>
  <% end %>
</div>
