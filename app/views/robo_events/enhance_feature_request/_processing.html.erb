<%= render "shared/dropdown", label: "Enhance Feature Request", open_on_load: true do %>
  <%= render "shared/dropdown", label: "Prompt" do %>
    <%= render "shared/prompt_conversation", robo_request: robo_event.robo_request %>
  <% end %>

  <%= render "shared/dropdown", label: "Response", open_on_load: true do %>
    <pre id="ai-response-<%= robo_request.id %>" class="whitespace-pre-wrap"></pre>
  <% end %>
<% end %>
