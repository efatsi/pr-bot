<div
  id="robo-event-scaffold-<%= robo_event.id %>"
  data-controller="new-event"
  data-new-event-parent-id-value="<%= robo_event.parent_robo_event.id %>"
>
  <div class="relative pb-4">
    <div class="relative flex items-start space-x-3">
      <%# event icon %>
      <div class="relative">
        <div class="flex h-12 w-12 leading-3 items-center justify-center rounded-full text-center text-[10px] text-gray-400 bg-gray-800 border-2 border-gray-400 border-opacity-60 ring-8 ring-gray-800">
          <%== robo_event.event_keyword %>
        </div>
      </div>

      <%# processing details %>
      <div class="min-w-0 flex-1">
        <div class="mb-8">
          <%= render "robo_events/#{robo_event.event_type}/processing",
            robo_event: robo_event,
            robo_request: robo_request
          %>
        </div>
      </div>
    </div>
  </div>
</div>
