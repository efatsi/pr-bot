<% robo_job = robo_event.subject %>
<% open_on_load ||= false %>

<div id="robo-job-start">
  <%= render "shared/dropdown", label: "Feature & Files", open_on_load: open_on_load do %>
    <%= turbo_frame_tag "robo-job-start-details" do %>
      <div class="flex justify-end">
        <%= link_to edit_feature_and_files_robo_job_path(robo_job), class: "btn-opaque flex items-center justify-around gap-2" do %>
          <%= heroicon "pencil", options: { class: "!w-4 !h-4" } %>
          <span>Edit</span>
        <% end %>
      </div>

      <div class="flex gap-4">
        <div class="w-3/5">
          <div class="section-label">Feature Request:</div>
          <div>
            <%= render "shared/render_md_and_code", body: robo_job.feature_request %>
          </div>
        </div>

        <div class="w-2/5">
          <div class="section-label">Contextual Files:</div>
          <ul class="list-disc text-left">
            <% robo_job.seed_contextual_files.each do |filepath| %>
              <li class="flex items-center gap-1.5">
                <%= render "shared/file_path_presence", project: robo_job.project, filepath: filepath %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
