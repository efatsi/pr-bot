<div>
  <div class="relative pb-4">
    <%# vertical line, hidden if it's the last one %>
    <span
      id="child-event-line-<%= robo_event.id %>"
      class="absolute left-6 top-6 -ml-px h-full w-0.5 bg-gray-400 bg-opacity-50 <%= 'hidden' if robo_event.child_robo_events.none? %>"
      aria-hidden="true"
    ></span>

    <div class="relative flex items-start space-x-3">
      <%# event icon %>
      <div class="relative">
        <div class="flex h-12 w-12 leading-3 items-center justify-center rounded-full text-center text-[10px] text-gray-400 bg-gray-800 border-2 border-gray-400 border-opacity-60 ring-8 ring-gray-800">
          <%== robo_event.event_keyword %>
        </div>
      </div>

      <%# event details %>
      <div class="min-w-0 flex-1">
        <div class="mb-8">
          <%= render "robo_events/#{robo_event.event_type}/details", robo_event: robo_event %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if robo_event.child_robo_events.any? %>
  <%# render the next event in the sequence if it exists %>
  <% robo_event.child_robo_events.each do |child_event| %>
    <%= render "robo_events/list_item", robo_event: child_event %>
  <% end %>

<% else %>
  <%# we're at the end of the event line, render buttons to enable next steps %>
  <div id="next-steps">
    <%= render "robo_events/#{robo_event.event_type}/next_steps", robo_event: robo_event %>
  </div>

<% end %>
