<li>
  <div class="relative pb-4">
    <%# vertical line, not rendered if it's the last one %>
    <% if robo_event.child_robo_events.any? %>
      <span class="absolute left-6 top-6 -ml-px h-full w-0.5 bg-gray-400 bg-opacity-50" aria-hidden="true"></span>
    <% end %>

    <div class="relative flex items-start space-x-3">
      <%# event icon %>
      <div class="relative">
        <div class="flex h-12 w-12 leading-3 items-center justify-center rounded-full text-center text-[10px] text-gray-400 bg-gray-800 border-2 border-gray-400 border-opacity-60 ring-8 ring-gray-800">
          <%== robo_event.event_keyword %>
        </div>
      </div>

      <%# event details %>
      <div class="min-w-0 flex-1">
        <div class="mb-8">
          <%= render "robo_events/details/#{robo_event.event_type}", robo_event: robo_event %>

          <% if robo_event.child_robo_events.none? %>
            <%= render "robo_events/next_steps/#{robo_event.event_type}", robo_event: robo_event %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</li>

<% robo_event.child_robo_events.each do |child_event| %>
  <%= render "robo_events/list_item", robo_event: child_event %>
<% end %>
