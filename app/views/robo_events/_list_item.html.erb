<% has_children = robo_event.child_robo_events.active.any? %>

<div id="robo-event-<%= robo_event.id %>">
  <%= render "shared/ding" if robo_event.just_finished %>

  <%= render "robo_events/event_body", robo_event: robo_event %>

  <%# render children within the robo-event-id div so turbo updates update children events as well %>
  <% if has_children %>
    <%# render the next event in the sequence if it exists %>
    <%= render "robo_events/list_item", robo_event: robo_event.child_robo_events.active.first %>

  <% else %>
    <%# we're at the end of the event line, render buttons to enable next steps %>
    <%= render "robo_events/next_steps", robo_event: robo_event %>

  <% end %>
</div>
