<% robo_job ||= robo_event.robo_job %>

<div id="next-steps-<%= robo_event.id %>">
  <div class="flex justify-center text-center gap-8 mb-4">
    <% if robo_event.actions.executed.exists? %>
      <div>
        <p>save progress?</p>
        <%= link_to 'Create Git Commit', new_robo_job_git_commit_path(robo_job), class: "btn-opaque block"
        %>
      </div>
    <% end %>

    <div>
      <p>more to automate?</p>
      <%= link_to "Followup Conversation", new_robo_job_followup_job_path(robo_job), class: "btn-primary block" %>
    </div>
  </div>
</div>
