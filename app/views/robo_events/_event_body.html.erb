<% has_children = robo_event.child_robo_events.active.any? %>
<% has_siblings = robo_event.sibling_events.any? %>

<div class="relative pb-4" id="robo-event-body-<%= robo_event.id %>">
  <%# vertical line %>
  <% if has_siblings %>
    <span class="absolute left-6 top-[4.5rem] -ml-px h-[calc(100%-3rem)] w-0.5 bg-gray-400 bg-opacity-50" aria-hidden="true"></span>
  <% else %>
    <span class="absolute left-6 top-[1.5rem] -ml-px h-full w-0.5 bg-gray-400 bg-opacity-50" aria-hidden="true"></span>
  <% end %>

  <div class="relative flex items-start space-x-3">
    <%# event icon %>
    <div class="relative" data-controller="dropdown-menu">
      <div class="flex flex-col items-center">
        <div data-action="click->dropdown-menu#toggle" class="flex h-12 w-12 leading-3 items-center justify-center rounded-full text-center text-[10px] text-gray-400 bg-gray-800 border-2 border-gray-400 border-opacity-60 ring-8 ring-gray-800 hover:text-gray-300 hover:border-gray-300 cursor-pointer">
          <%== robo_event.event_keyword %>
        </div>

        <%# sibling pagination %>
        <% if has_siblings %>
          <div class="flex gap-0.5 items-center mt-0.5">
            <% if robo_event.younger_siblings.any? %>
              <%= link_to show_sibling_robo_event_path(robo_event.younger_siblings.last, current_event_id: robo_event.id) do %>
                <%= heroicon "chevron-left", options: { class: "!w-3 !h-3 text-gray-400" } %>
              <% end %>
            <% else %>
              <div class="w-3"><%# mimic space of chevron link %></div>
            <% end %>

            <code class="text-[10px] text-gray-400 my-0.5">
              <%= robo_event.sibling_position %>/<%= robo_event.all_sibling_events.count %>
            </code>

            <% if robo_event.older_siblings.any? %>
              <%= link_to show_sibling_robo_event_path(robo_event.older_siblings.first, current_event_id: robo_event.id) do %>
                <%= heroicon "chevron-right", options: { class: "!w-3 !h-3 text-gray-400" } %>
              <% end %>
            <% else %>
              <div class="w-3"><%# mimic space of chevron link %></div>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# hidden dropdown options %>
      <div data-dropdown-menu-target="dropdown" class="hidden absolute top-10 left-10 flex flex-col items-center justify-center bg-gray-800 border-2 border-gray-400 border-opacity-60 rounded-md py-1 w-32 z-40">
        <%= render "robo_events/util/dropdown_options", robo_event: robo_event, has_children: has_children %>
      </div>
    </div>

    <%# event details %>
    <div class="min-w-0 flex-1">
      <div class="mb-8">
        <%= render "robo_events/#{robo_event.event_type}/details",
          robo_event: robo_event,
          open_on_load: !has_children && (robo_event.is_start_event? || robo_event.is_instruction_event?)
        %>
      </div>
    </div>
  </div>
</div>
