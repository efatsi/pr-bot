<% is_processing ||= false %>

<div id="contextual-file-<%= contextual_file.id %>">
  <% label_buttons = render("robo_events/expand_contextual_files/label_buttons/#{contextual_file.status}",
    contextual_file: contextual_file
  )%>

  <% if is_processing %>
    <% label_icon = render("shared/contextual_file_icon", spinner: true) %>
  <% else %>
    <% label_icon = render("shared/contextual_file_icon", contextual_file: contextual_file) %>
  <% end %>

  <%= render "shared/dropdown",
    label: render("shared/file_path_presence", project: robo_job.project, filepath: contextual_file.filepath),
    label_icon: label_icon,
    label_class: contextual_file.accepted? ? "bg-[#264131]" : "bg-[#263141]",
    label_buttons: label_buttons,
    open_on_load: contextual_file.pending? do
  %>
    <div class="z-50">
      <div class="mb-2 flex flex-col gap-4">
        <% if reasoning = contextual_file.robo_reasoning %>
          <div class="flex items-center text-sm mr-[25%]">
            <div><%= markdown_to_html(reasoning) %></div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
