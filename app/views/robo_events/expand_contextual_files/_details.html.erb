<% open_on_load ||= robo_event.just_finished %>
<% robo_job = robo_event.robo_job %>

<%= turbo_frame_tag "robo-event-details-#{robo_event.id}" do %>
  <%= render "shared/dropdown", label: "Expand Contextual Files", open_on_load: open_on_load do %>
    <div class="flex flex-col justify-center gap-1 w-20 float-right mr-4">
      <% robo_event.robo_requests.each do |robo_request| %>
        <div class="flex flex-col items-center">
          <%= link_to conversation_robo_request_path(robo_request), "data-turbo-frame": "modal", class: "w-20" do %>
            <div class="inline-flex items-center justify-around gap-1 btn-opaque btn-slim text-sm">
              <span>convo</span>
              <%= heroicon "arrow-top-right-on-square", options: { class: "!w-4 !h-4" } %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="mb-8">
      <div class="font-semibold mb-0.5">Seed Contextual Files</div>

      <ul class="list-disc text-left">
        <% robo_job.seed_contextual_files.sort.each do |filepath| %>
          <li class="flex items-center gap-1.5">
            <%= render "shared/file_path_presence", project: robo_job.project, filepath: filepath %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="mb-8">
      <div class="font-semibold mb-1">Examined Files</div>

      <div class="flex flex-col gap-1">
        <% robo_job.contextual_files.not_ignored.sort_by(&:relevance_order_key).each do |contextual_file| %>
          <%= render "robo_events/expand_contextual_files/contextual_file",
            robo_job: robo_job,
            contextual_file: contextual_file
          %>
        <% end %>
      </div>
    </div>

    <% ignored = robo_job.contextual_files.ignored %>
    <% if ignored.any? %>
      <div class="mb-2">
        <div class="font-semibold mb-1">Ignored</div>

        <div class="flex flex-col gap-1 mb-2">
          <% ignored.sort_by(&:relevance_order_key).each do |contextual_file| %>
            <%= render "robo_events/expand_contextual_files/contextual_file",
              robo_job: robo_job,
              contextual_file: contextual_file
            %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
