<%= render "robo_jobs/feature_details", robo_job: robo_job %>

<% robo_job.actions.each do |action| %>
  <%= turbo_frame_tag "action-#{action.id}" do %>
    <% if action.processing? %>
      <%= render "actions/processing", action: action %>
    <% else %>
      <%= render "actions/show", action: action %>
    <% end %>
  <% end %>
<% end %>

<div class="flex flex-col items-end" id="fire-all-<%= robo_job.id %>">
  <%= render "actions/buttons/fire_all", robo_job: robo_job %>
</div>
