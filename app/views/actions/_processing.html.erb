<% label_class = dropdown_label_bg_for(action) %>
<% label_buttons = render("shared/spinner") %>

<%= render "shared/dropdown", label: action.summary, label_class: label_class, label_buttons: label_buttons do %>
  <%= render "actions/type_details/#{action.action_type}", action: action %>

  <%= render "shared/dropdown", label: "Build Action", open_on_load: true do %>
    <%= render "shared/dropdown", label: "Prompt" do %>
      <%= render "shared/prompt_conversation", robo_request: robo_request %>
    <% end %>

    <%= render "shared/dropdown", label: "Response", open_on_load: true do %>
      <pre id="ai-response-<%= action.id %>" class="whitespace-pre-wrap"></pre>
    <% end %>
  <% end %>

<% end %>
