<div class="flex gap-8">
  <div class="mb-4">
    <div class="font-medium">File:</div>
    <%= action.timestamped_file %>
  </div>
</div>

<% if !action.in_plan_stage? %>
  <div class="flex mb-2 gap-1">
    <div class="diff-new">
      <div class="font-medium mb-2">New Content:</div>
      <pre><%= action.arguments[:new_content] %></pre>
    </div>
  </div>
<% end %>
