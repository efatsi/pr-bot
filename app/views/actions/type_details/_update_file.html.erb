<div class="flex gap-8">
  <div class="mb-4">
    <div class="font-medium">File:</div>
    <%= action.arguments[:file] %>
  </div>
</div>

<div class="flex flex-col mb-2 gap-1.5">
  <div class="diff-og">
    <pre><%= action.arguments[:original_content] %></pre>
  </div>

  <div class="diff-new">
    <pre><%= action.arguments[:new_content] %></pre>
  </div>
</div>
