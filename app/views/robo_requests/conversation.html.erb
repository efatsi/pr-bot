<%= render "shared/modal" do %>
  <div class="font-semibold inline-block border-b border-opacity-10 mb-4">Robo Conversation</div>

  <div class="mb-4 flex flex-col gap-2">
    <%= render "shared/dropdown", label: "Prompt" do %>
      <%= render "shared/prompt_conversation", robo_request: robo_request %>
    <% end %>

    <%= render "shared/dropdown", label: "Response", open_on_load: true do %>
      <pre class="whitespace-pre-wrap"><%= robo_request.response %></pre>
    <% end %>
  </div>
<% end %>
