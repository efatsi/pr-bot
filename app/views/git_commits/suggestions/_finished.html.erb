<%= render "shared/dropdown", label: "Commit Suggestions", open_on_load: true do %>
  <%= render "shared/dropdown", label: "Prompt" do %>
    <% robo_request.prompt_messages.each do |prompt_message| %>
      <div class="uppercase text-sm mb-2"><%= prompt_message["role"] %></div>
      <pre class="whitespace-pre-wrap mb-4"><%= prompt_message["content"] %></pre>
    <% end %>
  <% end %>

  <%= render "shared/dropdown", label: "Response" do %>
    <div class="whitespace-pre-wrap"><%= robo_request.response %></div>
  <% end %>

  <div class="px-1 mt-4">
    <div class="font-semibold mb-4">
      Suggestions:
    </div>

    <div class="flex flex-col gap-4 font-mono">
      <% git_commit.message_options.fetch("commits", []).each do |option| %>
        <div class="flex items-center mb-2 gap-2">
          <button data-action="commit-copy#useMessage" data-message="<%= option['message'] %>" data-description="<%= option['description'] %>" class="btn-opaque mr-2">
            <%= heroicon "arrow-up-on-square-stack", options: { class: "!w-4 !h-4" } %>
          </button>
          <div>
            <div><%= option['message'] %></div>
            <% if option['description'].present? %>
              <div class="ml-3 mt-0.5 text-sm whitespace-pre-wrap"><%= option['description'] %></div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
