<h1>New Git Commit</h1>

<%= simple_form_for([project, git_commit], html: { "data-controller": "commit-copy branch-select" }) do |f| %>
  <div class="mb-4">
    <%= f.label :branch %>
    <%= f.input :branch,
      label: false,
      collection: project.all_branches + ["+ new branch"],
      selected: project.current_branch,
      wrapper_html: { "data-branch-select-target": "selectWrapper" },
      input_html: { "data-action": "change->branch-select#checkInputs", class: "w-[200px]" }
    %>

    <div data-branch-select-target="newBranchWrapper" class="flex w-full items-start gap-3 hidden">
      <%= f.input :new_branch,
        label: false,
        as: :string,
        placeholder: "new branch name...",
        input_html: { class: "w-[200px]" }
      %>

      <%= link_to "Cancel", "#", class: "btn-opaque leading-6 mt-0.5", "data-action": "click->branch-select#revertInputs" %>
    </div>
  </div>

  <div class="max-w-[80%] mb-4">
    <%= f.input :message, input_html: { "data-commit-copy-target": "source" } %>
  </div>

  <div id="commit-suggestions" class="mb-8">
    <% if robo_request = git_commit.robo_requests.last %>
      <%= render "git_commits/suggestions/finished", robo_request: robo_request %>
    <% else %>
      <%= render "shared/stream_button", path: generate_options_project_git_commit_path(project, git_commit), label: "Fetch suggestions" %>
    <% end %>
  </div>

  <%= f.submit "Commit", class: "btn-primary" %>
  <%= link_to "Back", robo_job ? robo_job_path(robo_job) : project_path(project), class: "btn-opaque leading-6 inline-block" %>
<% end %>
