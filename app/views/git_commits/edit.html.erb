<h1>New Git Commit</h1>

<%= simple_form_for([project, git_commit]) do |f| %>
  <div class="max-w-[80%]">
    <%= f.input :message %>
  </div>

  <% if robo_request = git_commit.robo_requests.last %>
    <%= render "git_commits/suggestions/finished", robo_request: robo_request %>
  <% else %>
    <div id="commit-suggestions" class="mb-8">
      <%= render "shared/stream_button", path: generate_options_project_git_commit_path(project, git_commit), label: "Fetch suggestions" %>
    </div>
  <% end %>

  <%= f.submit "Save", class: "btn-primary" %>
  <%= link_to "Back", robo_job ? robo_job_path(robo_job) : project_path(project), class: "btn-opaque leading-6 inline-block" %>
<% end %>
